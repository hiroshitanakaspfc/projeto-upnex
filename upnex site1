<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="theme-color" content="#09090d">
    <meta name="description" content="UPNEX Studio — Desenvolvimento de sites modernos, experiências digitais e soluções para empresas que querem crescer.">

    <title>UPNEX Studio — Elevamos sua presença digital</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* ========================================
           UPNEX STUDIO — DESIGN SYSTEM
        ======================================== */

        :root {
            --bg: #09090d;
            --bg-secondary: #101015;
            --surface: #15151c;
            --purple: #923cff;
            --purple-light: #b77bff;
            --white: #f7f5fc;
            --muted: #9995a5;
            --border: rgba(255,255,255,0.10);
            --font-heading: 'Space Grotesk', sans-serif;
            --font-body: 'DM Sans', sans-serif;
            --container: 1200px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px;
        }

        body {
            background: var(--bg);
            color: var(--white);
            font-family: var(--font-body);
            overflow-x: hidden;
            line-height: 1.6;
        }

        body, button, input, textarea, select {
            font-family: var(--font-body);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button, input, textarea, select {
            font: inherit;
        }

        button, a {
            -webkit-tap-highlight-color: transparent;
        }

        button:focus-visible,
        a:focus-visible,
        input:focus-visible,
        textarea:focus-visible,
        select:focus-visible {
            outline: 2px solid var(--purple-light);
            outline-offset: 4px;
        }

        img {
            display: block;
            max-width: 100%;
        }

        ::selection {
            background: var(--purple);
            color: white;
        }

        .container {
            width: min(var(--container), 88%);
            margin-inline: auto;
        }

        .section {
            padding: 120px 0;
            position: relative;
        }

        .section-label {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--purple-light);
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 3px;
            font-weight: 700;
            margin-bottom: 24px;
        }

        .section-label::before {
            content: "";
            height: 1px;
            width: 28px;
            background: var(--purple);
        }

        .section-title {
            font-family: var(--font-heading);
            font-size: clamp(35px, 5vw, 65px);
            line-height: 1.08;
            letter-spacing: -2.5px;
            font-weight: 500;
            max-width: 800px;
        }

        .gradient-text {
            background: linear-gradient(110deg, #fff 10%, #b77bff 65%, #923cff 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .section-description {
            color: var(--muted);
            font-size: 15px;
            max-width: 510px;
            line-height: 1.9;
            margin-top: 24px;
        }

        /* ========================================
           HEADER
        ======================================== */

        .header {
            height: 84px;
            position: fixed;
            inset: 0 0 auto;
            z-index: 1000;
            display: flex;
            align-items: center;
            border-bottom: 1px solid transparent;
            transition: background .3s, border-color .3s;
        }

        .header.scrolled {
            background: rgba(9,9,13,.91);
            backdrop-filter: blur(18px);
            border-bottom-color: var(--border);
        }

        .nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
        }

        .logo {
            font-family: var(--font-heading);
            font-size: 28px;
            letter-spacing: -1.5px;
            font-weight: 700;
            white-space: nowrap;
        }

        .logo span {
            color: var(--purple-light);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 34px;
            list-style: none;
        }

        .nav-links a {
            color: #c0bdca;
            font-size: 12px;
            transition: color .25s;
        }

        .nav-links a:hover {
            color: white;
        }

        .nav-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 18px;
            border: 1px solid rgba(183,123,255,.5);
            font-size: 12px;
            transition: background .3s, transform .3s;
        }

        .nav-cta:hover {
            background: var(--purple);
            transform: translateY(-2px);
        }

        .menu-toggle {
            display: none;
            background: none;
            border: 0;
            color: white;
            font-size: 26px;
            cursor: pointer;
        }

        /* ========================================
           HERO
        ======================================== */

        .hero {
            min-height: 100svh;
            position: relative;
            display: flex;
            align-items: center;
            padding: 140px 0 75px;
            overflow: hidden;
            isolation: isolate;
        }

        .hero::before {
            content: "";
            position: absolute;
            z-index: -2;
            width: 650px;
            height: 650px;
            right: -160px;
            top: 8%;
            background: radial-gradient(circle, rgba(111,35,213,.22), transparent 68%);
            pointer-events: none;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.15fr .85fr;
            align-items: center;
            gap: 50px;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .availability {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: 1px solid var(--border);
            background: rgba(255,255,255,.025);
            padding: 9px 13px;
            font-size: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #d1ceda;
            margin-bottom: 35px;
        }

        .availability-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #a16aff;
            box-shadow: 0 0 12px #923cff;
        }

        .hero h1 {
            font-family: var(--font-heading);
            font-size: clamp(52px, 7.3vw, 96px);
            line-height: .98;
            letter-spacing: -5px;
            font-weight: 500;
        }

        .hero h1 span {
            display: block;
        }

        .hero-description {
            max-width: 470px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.9;
            margin: 30px 0;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .button-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            min-height: 52px;
            padding: 0 22px;
            background: var(--purple);
            color: white;
            border: 1px solid var(--purple);
            font-size: 12px;
            font-weight: 700;
            transition: transform .3s, background .3s, box-shadow .3s;
            cursor: pointer;
        }

        .button-primary:hover {
            transform: translateY(-3px);
            background: #a454ff;
            box-shadow: 0 12px 35px rgba(146,60,255,.2);
        }

        .button-primary .arrow {
            font-size: 19px;
            transition: transform .3s;
        }

        .button-primary:hover .arrow {
            transform: translateX(4px);
        }

        .text-link {
            color: #d0cbd8;
            font-size: 12px;
            border-bottom: 1px solid #62566f;
            padding-bottom: 5px;
            transition: color .3s;
        }

        .text-link:hover {
            color: var(--purple-light);
        }

        /* Composição visual do hero */

        .hero-visual {
            position: relative;
            min-height: 480px;
            display: grid;
            place-items: center;
            perspective: 1000px;
        }

        .visual-orbit {
            width: min(100%, 450px);
            aspect-ratio: 1;
            position: relative;
            display: grid;
            place-items: center;
            border: 1px solid rgba(183,123,255,.14);
            border-radius: 50%;
            animation: orbitPulse 7s ease-in-out infinite;
        }

        .visual-orbit::before,
        .visual-orbit::after {
            content: "";
            position: absolute;
            border: 1px solid rgba(183,123,255,.12);
            border-radius: 50%;
        }

        .visual-orbit::before {
            inset: 9%;
        }

        .visual-orbit::after {
            inset: 19%;
            border-color: rgba(183,123,255,.18);
        }

        .visual-core {
            width: 44%;
            aspect-ratio: 1;
            position: relative;
            display: grid;
            place-items: center;
            background: radial-gradient(circle at 35% 25%, #bc8bff, #6320ba 45%, #160c28 78%);
            border: 1px solid rgba(222,190,255,.5);
            box-shadow: 0 0 90px rgba(127,44,229,.3), inset 0 0 35px rgba(255,255,255,.1);
            transform: rotate(-12deg);
            animation: coreFloat 6s ease-in-out infinite;
        }

        .visual-core span {
            font-family: var(--font-heading);
            font-size: clamp(38px, 6vw, 70px);
            font-weight: 700;
            letter-spacing: -5px;
            text-shadow: 0 4px 30px rgba(0,0,0,.3);
        }

        .orbit-point {
            position: absolute;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #c99aff;
            box-shadow: 0 0 22px #923cff;
        }

        .orbit-point.one {
            top: 15%;
            right: 18%;
        }

        .orbit-point.two {
            bottom: 19%;
            left: 12%;
            width: 8px;
            height: 8px;
        }

        .orbit-point.three {
            bottom: 12%;
            right: 25%;
            width: 6px;
            height: 6px;
        }

        .visual-caption {
            position: absolute;
            bottom: 7%;
            right: 0;
            padding: 15px 19px;
            background: rgba(15,15,22,.85);
            border: 1px solid var(--border);
            backdrop-filter: blur(10px);
        }

        .visual-caption small {
            display: block;
            color: var(--muted);
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .visual-caption strong {
            display: block;
            font-family: var(--font-heading);
            font-size: 17px;
            margin-top: 4px;
            font-weight: 500;
        }

        .hero-index {
            position: absolute;
            bottom: 35px;
            left: 6%;
            font-size: 10px;
            letter-spacing: 2px;
            color: #77717f;
        }

        .scroll-indicator {
            position: absolute;
            bottom: 32px;
            right: 6%;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #a5a0af;
        }

        .scroll-line {
            width: 45px;
            height: 1px;
            background: var(--purple-light);
            transform-origin: left;
            animation: linePulse 2s ease-in-out infinite;
        }

        /* ========================================
           MARQUEE
        ======================================== */

        .marquee {
            overflow: hidden;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            background: #0c0b11;
            padding: 21px 0;
        }

        .marquee-track {
            display: flex;
            width: max-content;
            animation: marquee 30s linear infinite;
        }

        .marquee-item {
            display: flex;
            align-items: center;
            gap: 35px;
            padding-right: 35px;
            color: #bcb5c9;
            font-family: var(--font-heading);
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 3px;
            white-space: nowrap;
        }

        .marquee-item span {
            color: var(--purple-light);
            font-size: 19px;
        }

        /* ========================================
           SOBRE
        ======================================== */

        .about-grid {
            display: grid;
            grid-template-columns: .85fr 1.15fr;
            gap: 100px;
            align-items: start;
        }

        .about-side {
            position: sticky;
            top: 130px;
        }

        .about-copy {
            padding-top: 50px;
        }

        .about-copy p {
            color: var(--muted);
            font-size: 15px;
            line-height: 2;
            margin-bottom: 22px;
        }

        .about-statement {
            border-left: 2px solid var(--purple);
            padding: 5px 0 5px 25px;
            margin: 40px 0;
            font-family: var(--font-heading);
            font-size: clamp(22px, 3vw, 33px);
            line-height: 1.35;
        }

        .about-statement span {
            color: var(--purple-light);
        }

        .about-bottom {
            display: flex;
            align-items: center;
            gap: 15px;
            color: #d2cddd;
            font-size: 12px;
        }

        .about-bottom .symbol {
            color: var(--purple-light);
            font-size: 25px;
        }

        /* ========================================
           SERVIÇOS
        ======================================== */

        .services {
            background: var(--bg-secondary);
            border-top: 1px solid rgba(255,255,255,.04);
            border-bottom: 1px solid rgba(255,255,255,.04);
        }

        .services-heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 40px;
            margin-bottom: 65px;
        }

        .services-heading .section-description {
            max-width: 350px;
            margin-bottom: 5px;
        }

        .services-list {
            border-top: 1px solid var(--border);
        }

        .service-item {
            display: grid;
            grid-template-columns: 70px 1fr 1fr 35px;
            align-items: center;
            gap: 25px;
            padding: 30px 10px;
            border-bottom: 1px solid var(--border);
            transition: padding .35s, background .35s;
        }

        .service-item:hover {
            padding-left: 22px;
            padding-right: 22px;
            background: rgba(146,60,255,.045);
        }

        .service-number {
            color: var(--purple-light);
            font-size: 12px;
            font-family: var(--font-heading);
        }

        .service-item h3 {
            font-family: var(--font-heading);
            font-size: clamp(19px, 2.6vw, 28px);
            font-weight: 500;
            letter-spacing: -.8px;
        }

        .service-item p {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.8;
        }

        .service-arrow {
            font-size: 22px;
            color: var(--purple-light);
            transition: transform .3s;
        }

        .service-item:hover .service-arrow {
            transform: translate(4px, -4px);
        }

        /* ========================================
           PORTFÓLIO
        ======================================== */

        .portfolio-heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 30px;
            margin-bottom: 40px;
        }

        .portfolio-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 40px;
        }

        .filter-btn {
            background: transparent;
            color: #a8a3b2;
            border: 1px solid var(--border);
            padding: 10px 16px;
            cursor: pointer;
            font-size: 11px;
            transition: all .25s;
        }

        .filter-btn:hover,
        .filter-btn.active {
            color: white;
            background: var(--purple);
            border-color: var(--purple);
        }

        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 48px 25px;
        }

        .project-card {
            min-width: 0;
            animation: projectIn .45s ease both;
        }

        .project-card.hidden {
            display: none;
        }

        .project-preview {
            position: relative;
            overflow: hidden;
            background: #15131c;
            border: 1px solid var(--border);
            aspect-ratio: 1.42;
        }

        .project-art {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            padding: 25px;
            transition: transform .6s cubic-bezier(.2,.7,.2,1);
        }

        .project-card:hover .project-art {
            transform: scale(1.035);
        }

        .art-photography {
            background:
                linear-gradient(145deg, rgba(0,0,0,.05), rgba(0,0,0,.7)),
                radial-gradient(ellipse at 65% 40%, #d6b49b 0%, #65534e 26%, #282329 52%, #111116 80%);
        }

        .art-burger {
            background:
                radial-gradient(ellipse at 55% 53%, #f5b94e 0%, #bd5c20 18%, transparent 19%),
                radial-gradient(ellipse at 55% 48%, #56301c 0%, #2b1712 32%, transparent 33%),
                linear-gradient(145deg, #361b15, #120d0c 75%);
        }

        .art-bakery {
            background:
                radial-gradient(ellipse at 65% 65%, #f5d5a1 0%, #ad7445 22%, transparent 23%),
                radial-gradient(ellipse at 34% 30%, #d39b63 0%, #6e472f 25%, transparent 26%),
                linear-gradient(125deg, #5b3726, #21150f 70%);
        }

        .art-barber {
            background:
                radial-gradient(ellipse at 60% 50%, rgba(193,157,103,.5), transparent 30%),
                linear-gradient(120deg, #2d2925, #121212 65%);
        }

        .art-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,.8);
            position: relative;
            z-index: 2;
        }

        .art-mockup {
            position: absolute;
            width: 72%;
            height: 72%;
            left: 14%;
            top: 17%;
            background: rgba(15,13,17,.8);
            border: 1px solid rgba(255,255,255,.2);
            box-shadow: 0 20px 70px rgba(0,0,0,.3);
            transform: rotate(-4deg);
            transition: transform .5s;
            padding: 8px;
        }

        .project-card:hover .art-mockup {
            transform: rotate(0) translateY(-5px);
        }

        .mockup-browser {
            height: 12px;
            border-bottom: 1px solid rgba(255,255,255,.1);
            display: flex;
            gap: 4px;
            padding: 3px 4px;
        }

        .mockup-browser i {
            width: 4px;
            height: 4px;
            background: #a6a0ae;
            border-radius: 50%;
        }

        .mockup-content {
            height: calc(100% - 12px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 7%;
            position: relative;
            overflow: hidden;
        }

        .mockup-content::after {
            content: "";
            position: absolute;
            width: 60%;
            height: 130%;
            right: -20%;
            top: -15%;
            background: rgba(183,123,255,.12);
            transform: rotate(25deg);
        }

        .mockup-eyebrow {
            font-size: clamp(5px, .7vw, 9px);
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--purple-light);
            margin-bottom: 7px;
        }

        .mockup-title {
            font-family: var(--font-heading);
            font-size: clamp(16px, 3vw, 38px);
            line-height: 1.03;
            letter-spacing: -1px;
            max-width: 90%;
            position: relative;
            z-index: 1;
        }

        .mockup-line {
            width: 38%;
            height: 3px;
            background: var(--purple);
            margin-top: 12px;
        }

        .preview-overlay {
            position: absolute;
            inset: 0;
            background: rgba(9,9,13,.75);
            display: grid;
            place-items: center;
            opacity: 0;
            transition: opacity .35s;
            z-index: 5;
        }

        .project-card:hover .preview-overlay,
        .project-card:focus-within .preview-overlay {
            opacity: 1;
        }

        .preview-button {
            border: 1px solid rgba(255,255,255,.65);
            background: transparent;
            color: white;
            padding: 14px 18px;
            font-size: 11px;
            cursor: pointer;
            transition: background .3s, border-color .3s;
        }

        .preview-button:hover {
            background: var(--purple);
            border-color: var(--purple);
        }

        .project-info {
            display: flex;
            justify-content: space-between;
            align-items: start;
            gap: 20px;
            padding-top: 20px;
        }

        .project-info h3 {
            font-family: var(--font-heading);
            font-size: 23px;
            font-weight: 500;
            letter-spacing: -.7px;
        }

        .project-info p {
            color: var(--muted);
            font-size: 11px;
            margin-top: 6px;
        }

        .project-tag {
            color: var(--purple-light);
            font-size: 10px;
            border: 1px solid rgba(183,123,255,.25);
            padding: 7px 10px;
            white-space: nowrap;
        }

        .portfolio-note {
            margin-top: 45px;
            color: var(--muted);
            font-size: 11px;
            border-left: 2px solid var(--purple);
            padding-left: 15px;
        }

        /* ========================================
           PROCESSO
        ======================================== */

        .process {
            background: var(--bg-secondary);
        }

        .process-grid {
            display: grid;
            grid-template-columns: .8fr 1.2fr;
            gap: 100px;
        }

        .process-intro {
            position: sticky;
            top: 130px;
            align-self: start;
        }

        .process-steps {
            border-top: 1px solid var(--border);
        }

        .process-step {
            display: grid;
            grid-template-columns: 55px 1fr;
            gap: 20px;
            padding: 30px 0;
            border-bottom: 1px solid var(--border);
        }

        .step-number {
            font-family: var(--font-heading);
            color: var(--purple-light);
            font-size: 13px;
        }

        .process-step h3 {
            font-family: var(--font-heading);
            font-size: 23px;
            font-weight: 500;
            margin-bottom: 10px;
        }

        .process-step p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.9;
            max-width: 420px;
        }

        /* ========================================
           ORÇAMENTO
        ======================================== */

        .contact-grid {
            display: grid;
            grid-template-columns: .9fr 1.1fr;
            gap: 100px;
            align-items: start;
        }

        .contact-copy {
            position: sticky;
            top: 130px;
        }

        .contact-copy .section-title {
            font-size: clamp(40px, 5.5vw, 70px);
        }

        .contact-copy > p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.9;
            margin-top: 25px;
        }

        .contact-whatsapp {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin-top: 30px;
            color: #d9d2e5;
            font-size: 12px;
            border-bottom: 1px solid #665776;
            padding-bottom: 7px;
        }

        .contact-form {
