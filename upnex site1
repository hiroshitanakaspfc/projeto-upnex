                    <a href="#contato">Orçamento</a>
                </nav>

            </div>

            <div class="footer-bottom">
                <span>© <span id="year"></span> UPNEX Studio.</span>
                <span>Design & desenvolvimento digital.</span>
            </div>

        </div>

    </footer>


    <script>
        /* ========================================
           CONFIGURAÇÃO
        ======================================== */

        /*
         * IMPORTANTE:
         * Substitua pelo número oficial da UPNEX.
         * Use o código do país + DDD + número.
         * Exemplo de formato: 5511999999999
         */

        const UPNEX_WHATSAPP = "12992493129";

        /* Se o número vier só com DDD + telefone, adiciona o código do Brasil (55) */
        function whatsappDigits() {
            const digits = UPNEX_WHATSAPP.replace(/\D/g, "");
            if (!digits) return "";
            return digits.length <= 11 ? "55" + digits : digits;
        }

        /* Supabase (chave pública: só permite inserir contatos) */
        const SUPABASE_URL = "https://nazjcykovdxqxzhsiyrh.supabase.co";
        const SUPABASE_KEY = "sb_publishable_S6iBeZLYgjFBdnV9G2Z8_A_5xMSdUTx";

        function saveContact(data) {
            return fetch(SUPABASE_URL + "/rest/v1/contatos", {
                method: "POST",
                headers: {
                    "apikey": SUPABASE_KEY,
                    "Content-Type": "application/json",
                    "Prefer": "return=minimal"
                },
                body: JSON.stringify(data),
                keepalive: true
            }).then(response => response.ok).catch(() => false);
        }

        /* HEADER AO ROLAR */

        const header = document.getElementById("header");

        function updateHeader() {
            header.classList.toggle("scrolled", window.scrollY > 30);
        }

        window.addEventListener("scroll", updateHeader, { passive: true });

        updateHeader();


        /* MENU MOBILE */

        const menuToggle = document.getElementById("menuToggle");
        const navLinks = document.getElementById("navLinks");

        menuToggle.addEventListener("click", () => {
            const isOpen = navLinks.classList.toggle("open");

            menuToggle.setAttribute("aria-expanded", String(isOpen));
            menuToggle.setAttribute(
                "aria-label",
                isOpen ? "Fechar menu" : "Abrir menu"
            );

            menuToggle.textContent = isOpen ? "✕" : "☰";
        });

        navLinks.querySelectorAll("a").forEach(link => {
            link.addEventListener("click", () => {
                navLinks.classList.remove("open");
                menuToggle.setAttribute("aria-expanded", "false");
                menuToggle.setAttribute("aria-label", "Abrir menu");
                menuToggle.textContent = "☰";
            });
        });

        document.addEventListener("keydown", event => {
            if (event.key === "Escape") {
                navLinks.classList.remove("open");
                menuToggle.setAttribute("aria-expanded", "false");
                menuToggle.setAttribute("aria-label", "Abrir menu");
                menuToggle.textContent = "☰";
            }
        });


        /* REVELAÇÃO DURANTE A ROLAGEM */

        const revealElements = document.querySelectorAll(".reveal");

        const prefersReducedMotion = false;

        if ("IntersectionObserver" in window && !prefersReducedMotion) {

            const revealObserver = new IntersectionObserver(
                (entries, observer) => {

                    entries.forEach(entry => {

                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                            observer.unobserve(entry.target);
                        }

                    });

                },
                {
                    threshold: 0.12,
                    rootMargin: "0px 0px -35px 0px"
                }
            );

            revealElements.forEach(element => {
                revealObserver.observe(element);
            });

        } else {

            revealElements.forEach(element => {
                element.classList.add("visible");
            });

        }


        /* FILTROS DO PORTFÓLIO */

        const filterButtons = document.querySelectorAll(".filter-btn");
        const projectCards = document.querySelectorAll(".project-card");

        filterButtons.forEach(button => {

            button.addEventListener("click", () => {

                const selectedFilter = button.dataset.filter;

                filterButtons.forEach(item => {

                    const active = item === button;

                    item.classList.toggle("active", active);
                    item.setAttribute("aria-pressed", String(active));

                });

                projectCards.forEach(card => {

                    const category = card.dataset.category;

                    const shouldShow =
                        selectedFilter === "todos" ||
                        category === selectedFilter;

                    card.classList.toggle("hidden", !shouldShow);

                    if (shouldShow) {
                        card.style.animation = "none";

                        requestAnimationFrame(() => {
                            card.style.animation = "";
                        });
                    }

                });

            });

        });


        /* PRÉVIAS CONCEITUAIS */

        const previewButtons = document.querySelectorAll("[data-preview]");

        const previewDescriptions = {

            fotografia: {
                title: "Frames Studio",
                text: "Conceito de portfólio para fotografia, com foco na apresentação visual de imagens, identidade e trabalhos selecionados."
            },

            gastronomia: {
                title: "Blackstone Burger",
                text: "Conceito de site gastronômico para apresentar uma marca, destacar produtos e facilitar o acesso às informações comerciais."
            },

            padaria: {
                title: "Maison du Pain",
                text: "Conceito de site para padaria artesanal, com direção visual acolhedora e apresentação de produtos."
            },

            barbearia: {
                title: "Atelier Barber",
                text: "Conceito de presença digital para barbearia, com linguagem visual sofisticada e espaço para apresentar serviços."
            }

        };

        previewButtons.forEach(button => {

            button.addEventListener("click", () => {

                const project = previewDescriptions[button.dataset.preview];

                if (!project) return;

                alert(
                    project.title + "\n\n" +
                    project.text + "\n\n" +
                    "Esta é uma prévia conceitual dentro do portfólio UPNEX. " +
                    "Ela ainda não corresponde a um site independente publicado."
                );

            });

        });


        /* WHATSAPP */

        const whatsappLink = document.getElementById("whatsappLink");

        function openWhatsApp(message) {

            const phone = whatsappDigits();

            if (!phone) {

                const status = document.getElementById("formStatus");

                status.textContent =
                    "O WhatsApp ainda não foi configurado. " +
                    "Adicione o número oficial da UPNEX na variável " +
                    "UPNEX_WHATSAPP, no final deste arquivo.";

                status.style.color = "#ffbf80";

                return false;
            }

            const url =
                "https://wa.me/" +
                phone +
                "?text=" +
                encodeURIComponent(message);

            window.open(url, "_blank", "noopener,noreferrer");

            return true;
        }

        whatsappLink.addEventListener("click", event => {

            event.preventDefault();

            openWhatsApp(
                "Olá! Conheci a UPNEX Studio pelo site e gostaria de conversar sobre um projeto."
            );

        });


        /* FORMULÁRIO DE ORÇAMENTO */

        const budgetForm = document.getElementById("budgetForm");
        const formStatus = document.getElementById("formStatus");

        budgetForm.addEventListener("submit", async event => {

            event.preventDefault();

            formStatus.textContent = "";
            formStatus.style.color = "";

            if (!budgetForm.checkValidity()) {
                budgetForm.reportValidity();
                return;
            }

            const formData = new FormData(budgetForm);

            const name = String(formData.get("name") || "").trim();
            const company = String(formData.get("company") || "").trim();
            const email = String(formData.get("email") || "").trim();
            const phone = String(formData.get("phone") || "").trim();
            const type = String(formData.get("type") || "").trim();
            const budget = String(formData.get("budget") || "").trim();
            const details = String(formData.get("details") || "").trim();

            if (details.length < 10) {

                formStatus.textContent =
                    "Descreva seu projeto com pelo menos 10 caracteres.";

                formStatus.style.color = "#ffbf80";

                return;
            }

            const message = [
                "Olá, UPNEX Studio! Gostaria de solicitar um orçamento.",
                "",
                "NOME: " + name,
                "EMPRESA: " + (company || "Não informado"),
                "E-MAIL: " + email,
                "WHATSAPP DO CLIENTE: " + phone,
                "TIPO DE SITE: " + type,
                "ORÇAMENTO PREVISTO: " + budget,
                "",
                "SOBRE O PROJETO:",
                details
            ].join("\n");

            const submitButton = budgetForm.querySelector("button[type=submit]");
            submitButton.disabled = true;

            formStatus.textContent = "Enviando...";
            formStatus.style.color = "#c8a4ff";

            const timeout = new Promise(resolve => setTimeout(() => resolve(false), 10000));

            const saved = await Promise.race([
                saveContact({
                    nome: name,
                    empresa: company || null,
                    email: email,
                    whatsapp: phone,
                    tipo_site: type,
                    orcamento: budget || null,
                    detalhes: details
                }),
                timeout
            ]);

            submitButton.disabled = false;

            if (saved) {

                formStatus.textContent = "Enviado com sucesso! Em breve entraremos em contato.";
                formStatus.style.color = "#8ee6a8";
                budgetForm.reset();

            } else {

                formStatus.textContent =
                    "Não foi possível enviar agora. Verifique sua conexão e tente novamente.";
                formStatus.style.color = "#ffbf80";

            }

        });


        /* ANO AUTOMÁTICO */

        document.getElementById("year").textContent =
            new Date().getFullYear();

    </script>

